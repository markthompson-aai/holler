# Copy to .env and fill in. .env is gitignored.
ASSEMBLYAI_API_KEY=

# Optional overrides
# HOLLER_MODEL=claude-sonnet-5-5
# Claude's effort level: low, medium, high, xhigh, max, or default for the model's own
# HOLLER_EFFORT=medium
# HERDR_PATH=/Users/you/.local/bin/herdr
# Colon-separated folders whose agents are never read or messaged, each an absolute path or starting with ~
# HOLLER_EXCLUDE_PATHS=~/Desktop/customer-data:/Volumes/clients
# Comma-separated Herdr workspace labels to limit to (e.g. for a demo); empty means all
# HOLLER_WORKSPACES=demo
# Mac voice for answers read aloud if AssemblyAI's voice fails, by name or identifier (see System Settings > Accessibility > Spoken Content)
# HOLLER_VOICE=Zoe
# The key you hold to ask: right-option (the default), right-command or fn
# HOLLER_HOTKEY=right-option
# Holler reloads this file when you save it; Menu bar > Reload Settings does the same.
